# Supabase (프로젝트 설정 > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 배포 주소 (로그인 후 localhost 로 가는 문제 방지 — Vercel 프로덕션 URL)
# 예: https://kiki-kappa-ruddy.vercel.app  (끝에 / 없음)
NEXT_PUBLIC_SITE_URL=

# 네이버 지역 검색 (선택: 없으면 데모 데이터)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# n8n 챗봇 Webhook (선택: 있으면 메시지를 n8n으로 전달 후 응답 병합)
N8N_CHAT_WEBHOOK_URL=
