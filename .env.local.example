# 복사해서 .env.local 로 저장한 뒤, 아래 값만 채우세요. (이 파일에는 비밀을 넣지 마세요 — Git에 포함됩니다.)
#
# Supabase (프로젝트 설정 > API — Publishable 키를 ANON_KEY에 넣음)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포 주소 (OAuth·결제 리다이렉트 — Vercel 프로덕션 URL, 끝에 / 없음)
NEXT_PUBLIC_SITE_URL=

# 네이버 지역 검색 (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# n8n 챗봇 Webhook (선택)
N8N_CHAT_WEBHOOK_URL=

# Supabase 서비스 롤 (서버 전용 — 결제 DB 기록용)
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 — 아래 둘 중 하나만 사용 (같은 상점의 클라이언트·시크릿 짝 유지)
# A) API 개별 연동 키 → 통합 결제창 (payment SDK). 우선 적용됨.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
# B) 결제위젯 연동 키 — A가 비어 있을 때만 (위젯 UI + 빌링 API와 동일 키 세트 권장)
NEXT_PUBLIC_TOSS_WIDGET_CLIENT_KEY=
TOSS_WIDGET_SECRET_KEY=
